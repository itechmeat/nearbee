# Nearbee environment. Copy to .env (ignored by git) and fill in.
# Variables already set in the process environment win over this file.

# URL of Nearbee's own apb dashboard (optional; default http://127.0.0.1:7322).
APB_URL=http://127.0.0.1:7322

# apb API key, only when the dashboard is configured to require one (optional).
APB_API_KEY=

# NEAR AI Cloud API key for the nearbee-near profile (required).
# Get one at https://cloud.near.ai; it reaches the executors through
# Nearbee's apb instance environment, never through a playbook or a profile.
NEARAI_API_KEY=your-near-ai-cloud-key
