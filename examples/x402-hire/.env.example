# The demo caller's credentials (copy to .env, which is ignored). The
# private key is never printed; NEARBEE_* variables belong to the adapter,
# not to this script.
NEAR_CALLER_ACCOUNT_ID=caller.testnet
NEAR_CALLER_PRIVATE_KEY=ed25519:<64 base58 characters>
# Optional overrides:
# NEAR_RPC_URL=https://rpc.mainnet.fastnear.com
# NEAR_A2A_URL=https://<handle>.market.near.ai/a2a/v1
